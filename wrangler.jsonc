{
  // Konfiguration für den Konto-Dienst (Cloudflare Worker). Cloudflare liest sie beim Bereitstellen aus GitHub.
  // Der Name muss genau der des vorhandenen Workers sein.
  "name": "winter-violet-1a11",
  "main": "konto-dienst.mjs",
  "compatibility_date": "2026-01-01",
  // Variablen, die im Dashboard stehen (ERLAUBTE_URSPRUENGE, ENTWICKLUNG) und das Geheimnis PASSWORT_PEPPER bleiben erhalten.
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mobimory-konten-test",
      "database_id": "10f467cb-4ae5-431c-a7f8-21ff89ae5bc7"
    }
  ]
}
